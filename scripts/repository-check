#!/bin/sh
# Project-local static verification for the ERPNext deployment repository.
#
# This checker deliberately validates only repository-owned deployment material. It does not enforce
# an account-wide canon and it does not connect to, mutate, or validate a live ERPNext installation.
set -eu

ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || {
  printf 'FAIL: not inside a git repository\n' >&2
  exit 1
}
cd "$ROOT"

fail=0
pass() { printf 'ok: %s\n' "$1"; }
fail_one() { printf 'FAIL: %s\n' "$1" >&2; fail=1; }

for f in \
  README.md \
  Makefile \
  workflow.json \
  config/erpnext.env \
  config/common_site_config.json \
  config/site_config.json \
  config/docker-daemon.json \
  config/compose.lxc.yaml \
  config/mariadb-tuning.cnf \
  scripts/backup.sh \
  scripts/monitor.sh \
; do
  if [ -f "$f" ]; then
    pass "required file $f"
  else
    fail_one "missing required file $f"
  fi
done

if git diff --check; then
  pass 'git diff whitespace check'
else
  fail_one 'git diff whitespace check failed'
fi

if command -v python3 >/dev/null 2>&1; then
  if python3 - workflow.json <<'PY'
import json
import pathlib
import sys

def require(condition, message):
    if not condition:
        raise SystemExit(message)

try:
    with open(sys.argv[1], encoding='utf-8') as source:
        adapter = json.load(source)
    require(adapter.get('kind') == 'workflow.github-project-adapter', 'unexpected adapter kind')
    require(adapter.get('schema_version') == '1.0.0', 'unexpected adapter schema version')
    require(adapter.get('repository') == 'HughZadora/erpnext-cn-deploy', 'repository pointer mismatch')
    require(adapter.get('project') == {
        'number': 9,
        'url': 'https://github.com/users/HughZadora/projects/9',
    }, 'GitHub Project pointer mismatch')
    require(adapter.get('root_outcome_issue') == {
        'number': 6,
        'url': 'https://github.com/HughZadora/erpnext-cn-deploy/issues/6',
    }, 'root outcome pointer mismatch')
    graph = adapter.get('work_graph', {})
    require(graph.get('parent_child') == 'GitHub native sub-issues', 'parent/child graph must be GitHub-native')
    require(graph.get('blocked_by') == 'GitHub native blocked-by relationships', 'dependencies must be GitHub-native')
    require('do not mirror status or dependencies' in graph.get('source_of_truth', ''), 'adapter must not duplicate task state')
    require(not any(key in adapter for key in ('tasks', 'status', 'frontier', 'dependencies', 'blockers')),
            'adapter must not define a second task graph')
    path_map = adapter.get('read_paths_by_leaf')
    require(isinstance(path_map, dict) and '7' in path_map, 'missing tracer read-path entry')
    for issue, paths in path_map.items():
        require(issue.isdecimal(), f'invalid leaf issue number: {issue!r}')
        require(isinstance(paths, list) and paths and len(paths) == len(set(paths)),
                f'invalid read-path list for issue {issue}')
        for raw in paths:
            path = pathlib.PurePosixPath(raw)
            require(raw and not path.is_absolute() and '..' not in path.parts and path.as_posix() == raw,
                    f'invalid repository read path: {raw!r}')
    require(set(('AGENTS.md', 'scripts/repository-check', 'workflow.json')).issubset(path_map['7']),
            'tracer read-path entry does not match issue #7')
except (OSError, ValueError, TypeError, AttributeError) as error:
    raise SystemExit(f'workflow.json validation failed: {error}')
PY
  then
    pass 'workflow.json adapter structure and native-state pointers'
  else
    fail_one 'workflow.json adapter structure'
  fi
else
  fail_one 'python3 is required to validate workflow.json'
fi

for script in scripts/repository-check scripts/backup.sh scripts/monitor.sh; do
  [ -f "$script" ] || continue
  if sh -n "$script"; then
    pass "$script shell syntax"
  else
    fail_one "$script shell syntax"
  fi
done

if make -n help >/dev/null; then
  pass 'Makefile parses and exposes the help target'
else
  fail_one 'Makefile dry-run failed'
fi

if command -v python3 >/dev/null 2>&1; then
  for json in config/common_site_config.json config/site_config.json config/docker-daemon.json workflow.json; do
    [ -f "$json" ] || continue
    if python3 -m json.tool "$json" >/dev/null; then
      pass "$json JSON syntax"
    else
      fail_one "$json JSON syntax"
    fi
  done
else
  printf 'note: python3 unavailable; JSON syntax checks skipped locally\n'
fi

if [ "$fail" -ne 0 ]; then
  printf 'repository verification failed\n' >&2
  exit 1
fi

printf 'repository verification success\n'
